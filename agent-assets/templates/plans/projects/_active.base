filters:
  and:
    - file.inFolder("plans/projects")
    - state != "archived"
views:
  - type: table
    name: "Active projects"
    order: [file.name, state, next_milestone, due, updated]
    sort:
      - property: updated
        direction: desc
  - type: cards
    name: "By state"
    group_by: state

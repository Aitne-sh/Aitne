{
  "name": "@aitne/daemon",
  "version": "0.1.11",
  "description": "Aitne daemon — long-running TypeScript service that hosts the event bus, scheduler, observers, safety layer, and HTTP API. Consumed by the `aitne` CLI; not intended for standalone use.",
  "homepage": "https://github.com/Aitne-sh/Aitne#readme",
  "bugs": {
    "url": "https://github.com/Aitne-sh/Aitne/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aitne-sh/Aitne.git",
    "directory": "packages/daemon"
  },
  "license": "MIT",
  "author": "Aitne contributors",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "node ../../scripts/rm-paths.mjs dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@aitne/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "@azure/msal-node": "^3.8.10",
    "@hono/node-server": "^1.19.13",
    "@huggingface/transformers": "^3.7.6",
    "@iarna/toml": "^2.2.5",
    "@notionhq/client": "^5.17.0",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "1.14.50",
    "@slack/bolt": "^4.7.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.8.0",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "discord.js": "^14.26.2",
    "dotenv": "^16.5.0",
    "ffmpeg-static": "^5.2.0",
    "file-type": "^22.0.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "heap-js": "^2.7.1",
    "hono": "^4.12.25",
    "html-to-text": "^9.0.5",
    "ical.js": "^2.2.1",
    "imapflow": "^1.3.1",
    "js-yaml": "^4.1.0",
    "mailparser": "^3.9.8",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "open": "^10.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.49.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3",
    "tsdav": "^2.1.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/html-to-text": "^9.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}

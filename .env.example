# Bootstrap only. Runtime settings live in SQLite and secrets live in the macOS Keychain.

PA_DATA_DIR=~/.personal-agent
PA_WORKSPACE_DIR=.
PA_API_PORT=8321

# Log level: trace | debug | info (default) | warn | error | fatal | silent
PA_LOG_LEVEL=

# Optional dev override. In production the dashboard proxy defaults to localhost.
PA_API_BASE_URL=

# ReadSensitive API auth enforcement. Default: true (reject unauthenticated).
# Set to false for soft enforcement (log warning but allow).
PA_ENFORCE_READ_TOKEN=
